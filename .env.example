# Supabase Configuration (From your own project: Dashboard > Project Settings > API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Supabase Service Role Key (Keep private! Never commit this or expose it to the browser)
# Dashboard > Project Settings > API > secret / service_role
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Session Security (Any random 32+ character string for JWT signing)
SESSION_SECRET="theway_revolutionary_portal_jwt_secret_key_2026"

# Google OAuth Client ID (From Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID="998492025686-flk32n9j8s28b5r3s98l1k18k2h7h51o.apps.googleusercontent.com"

# Local Server Port (Default: 3000)
PORT=3000

# Admin Credentials for Email & Password Login
ADMIN_EMAIL="joysriram.sarkar.56@gmail.com"
ADMIN_PASSWORD="theway@admin2026"
