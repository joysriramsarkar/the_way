{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/section/:path*", "destination": "/section.html" },
    { "source": "/article/:path*", "destination": "/api/article-seo?slug=:path*" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/admin-login.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/resource", "destination": "/resource.html" },
    { "source": "/solidarity", "destination": "/solidarity.html" },
    { "source": "/feed", "destination": "/feed.html" },
    { "source": "/directory", "destination": "/directory.html" },
    { "source": "/groups", "destination": "/groups.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/translations", "destination": "/translations.html" },
    { "source": "/organizations", "destination": "/organizations.html" },
    { "source": "/languages", "destination": "/languages.html" },
    { "source": "/api/activity-log", "destination": "/api/admins?_route=activity-log" },
    { "source": "/api/submissions", "destination": "/api/articles?_route=submissions" },
    { "source": "/api/movement", "destination": "/api/network?_route=movement" },
    { "source": "/api/resources", "destination": "/api/search?_route=resources" },
    { "source": "/api/v1/:path*", "destination": "/api/v1?endpoint=:path*" }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/|section/.*|events|admin|login|books|book-reader)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
