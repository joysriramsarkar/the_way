{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/section/:path*", "destination": "/section.html" },
    { "source": "/article/:path*", "destination": "/api/article-seo?slug=:path*" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/admin-login.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
